{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://portelyra.invalid/contracts/desktop-release/v1/backup-manifest.schema.json",
  "type":"object","additionalProperties":false,
  "required":["desktop_backup_version","backup_format","product_version","created_at_utc","tenant_id","user_id","data_space_id","registry_revision","scope_profile","entry_count","source_tree_fingerprint","entries","automatic_restore","contains_release_code","backup_manifest_fingerprint"],
  "properties":{
    "desktop_backup_version":{"const":1},"backup_format":{"const":"portelyra_desktop_backup_v1"},
    "product_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+(?:-rc\\.[0-9]+)?$"},
    "created_at_utc":{"$ref":"#/$defs/utc"},"tenant_id":{"type":"string","pattern":"^ten_[a-f0-9]{32}$"},
    "user_id":{"type":"string","pattern":"^usr_[a-f0-9]{32}$"},"data_space_id":{"type":"string","pattern":"^sbx_[a-f0-9]{32}$"},
    "registry_revision":{"const":1},"scope_profile":{"const":"complete_active_data_space_v1"},
    "entry_count":{"type":"integer","minimum":1},"source_tree_fingerprint":{"$ref":"#/$defs/sha"},
    "entries":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/entry"}},
    "automatic_restore":{"const":false},"contains_release_code":{"const":false},
    "backup_manifest_fingerprint":{"$ref":"#/$defs/sha"}
  },
  "$defs":{
    "sha":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "utc":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "entry":{"type":"object","additionalProperties":false,"required":["relative_path","entry_type","mode","byte_count","bytes_fingerprint"],"properties":{
      "relative_path":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"},
      "entry_type":{"enum":["directory","file"]},"mode":{"enum":["0400","0600","0700"]},
      "byte_count":{"type":["integer","null"],"minimum":0},"bytes_fingerprint":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/sha"}]}
    }}
  }
}

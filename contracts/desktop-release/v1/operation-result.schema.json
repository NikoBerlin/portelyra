{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://portelyra.invalid/contracts/desktop-release/v1/operation-result.schema.json",
  "$defs":{
    "summary":{"type":"object","additionalProperties":false,"required":["created_at_utc","product_version","entry_count","file_count","byte_count"],"properties":{
      "created_at_utc":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},"product_version":{"type":"string"},
      "entry_count":{"type":"integer","minimum":1},"file_count":{"type":"integer","minimum":0},"byte_count":{"type":"integer","minimum":0}
    }}
  },
  "oneOf":[
    {"type":"object","additionalProperties":false,"required":["desktop_release_version","operation","status","safe_output","automatic_retry"],"properties":{
      "desktop_release_version":{"const":1},"operation":{"enum":["backup","restore","release_build"]},
      "status":{"enum":["created","already_created","restored","already_restored"]},"safe_output":{"const":true},"automatic_retry":{"const":false},"signature":{"enum":["valid"]},
      "created_at_utc":{"$ref":"#/$defs/summary/properties/created_at_utc"},"product_version":{"type":"string"},
      "entry_count":{"type":"integer","minimum":1},"file_count":{"type":"integer","minimum":0},"byte_count":{"type":"integer","minimum":0}
    }},
    {"type":"object","additionalProperties":false,"required":["status","operation","safe_output"],"properties":{
      "status":{"enum":["valid","ready_for_confirmed_restore"]},"operation":{"enum":["backup_check","restore_preflight","release_check"]},"safe_output":{"const":true},"signature":{"enum":["valid","not_required"]},
      "created_at_utc":{"$ref":"#/$defs/summary/properties/created_at_utc"},"product_version":{"type":"string"},
      "entry_count":{"type":"integer","minimum":1},"file_count":{"type":"integer","minimum":0},"byte_count":{"type":"integer","minimum":0}
    }},
    {"type":"object","additionalProperties":false,"required":["status","operation","safe_output","keep_count","kept","removed","invalid_kept_count","other_data_space_or_newer_count","foreign_entry_count","removed_byte_count","enough_valid","plan_fingerprint"],"properties":{
      "status":{"enum":["planned","pruned"]},"operation":{"const":"backup_prune"},"safe_output":{"const":true},
      "keep_count":{"type":"integer","minimum":1,"maximum":50},
      "kept":{"type":"array","items":{"$ref":"#/$defs/summary"}},"removed":{"type":"array","items":{"$ref":"#/$defs/summary"}},
      "invalid_kept_count":{"type":"integer","minimum":0},"other_data_space_or_newer_count":{"type":"integer","minimum":0},
      "foreign_entry_count":{"type":"integer","minimum":0},"removed_byte_count":{"type":"integer","minimum":0},
      "enough_valid":{"type":"boolean"},"plan_fingerprint":{"type":"string","pattern":"^[a-f0-9]{64}$"}
    }},
    {"type":"object","additionalProperties":false,"required":["desktop_release_version","status","operation","safe_output","bundles","foreign_entry_count"],"properties":{
      "desktop_release_version":{"const":1},"status":{"const":"listed"},"operation":{"const":"backup_list"},"safe_output":{"const":false},
      "bundles":{"type":"array","items":{"type":"object","additionalProperties":false,
        "required":["name","created_at_utc","product_version","entry_count","file_count","byte_count","own_data_space","newer_version"],"properties":{
          "name":{"type":"string","pattern":"^[A-Za-z0-9_][A-Za-z0-9._-]{0,119}$"},
          "created_at_utc":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},"product_version":{"type":"string"},
          "entry_count":{"type":"integer","minimum":1},"file_count":{"type":"integer","minimum":0},"byte_count":{"type":"integer","minimum":0},
          "own_data_space":{"type":["boolean","null"]},"newer_version":{"type":"boolean"}}}},
      "foreign_entry_count":{"type":"integer","minimum":0}
    }},
    {"type":"object","additionalProperties":false,"required":["desktop_release_version","status","operation","safe_output","automatic_retry","product_version","created_at_utc","relocation"],"properties":{
      "desktop_release_version":{"const":1},"status":{"const":"restored"},"operation":{"const":"restore_fresh"},"safe_output":{"const":true},"automatic_retry":{"const":false},
      "product_version":{"type":"string"},"created_at_utc":{"$ref":"#/$defs/summary/properties/created_at_utc"},
      "relocation":{"enum":["not_needed","recorded","present","unverified","not_possible"]}
    }}
  ]
}

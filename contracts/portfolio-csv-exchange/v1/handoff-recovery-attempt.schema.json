{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portelyra.local/contracts/portfolio-csv-exchange/v1/handoff-recovery-attempt.schema.json",
  "title": "Portfolio CSV domain handoff recovery consumed attempt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["portfolio_csv_handoff_recovery_attempt_version","status","context_fingerprint","recovery_plan_fingerprint","recovery_confirmation_fingerprint","attempted_at_utc","recovery_attempt_fingerprint"],
  "properties": {
    "portfolio_csv_handoff_recovery_attempt_version": {"const": 1},
    "status": {"const": "recovery_confirmation_consumed"},
    "context_fingerprint": {"$ref": "#/$defs/sha256"},
    "recovery_plan_fingerprint": {"$ref": "#/$defs/sha256"},
    "recovery_confirmation_fingerprint": {"$ref": "#/$defs/sha256"},
    "attempted_at_utc": {"$ref": "#/$defs/utc"},
    "recovery_attempt_fingerprint": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}

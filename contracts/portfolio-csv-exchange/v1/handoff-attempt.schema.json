{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portelyra.local/contracts/portfolio-csv-exchange/v1/handoff-attempt.schema.json",
  "title": "Portfolio CSV domain handoff consumed attempt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["portfolio_csv_handoff_attempt_version","status","context_fingerprint","domain","trusted_preview","confirmation","attempted_at_utc","automatic_retry","attempt_fingerprint"],
  "properties": {
    "portfolio_csv_handoff_attempt_version": {"const": 1},
    "status": {"const": "confirmation_consumed_before_domain_effect"},
    "context_fingerprint": {"$ref": "#/$defs/sha256"},
    "domain": {"enum": ["catalog","coupled_transaction","asset_activity","cash_coverage"]},
    "trusted_preview": {"type": "object"},
    "confirmation": {"type": "object"},
    "attempted_at_utc": {"$ref": "#/$defs/utc"},
    "automatic_retry": {"const": false},
    "attempt_fingerprint": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}

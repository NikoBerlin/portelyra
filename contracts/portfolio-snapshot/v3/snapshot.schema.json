{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portfolio-Snapshot v3",
  "description": "Unveraenderliches Stichtagsbild mit Frische je Ebene. Der Wert eines Tages stammt aus dem Bewertungsstand; fehlende Werte erscheinen als Fehlendes, nie als null.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "portfolio_snapshot_version", "snapshot_id", "status", "snapshot_status",
    "tenant_id", "user_id", "data_space_id", "portfolio_id", "portfolio_label",
    "base_currency", "as_of_date", "completed_at_utc", "freshness", "positions",
    "excluded_positions", "totals", "counts", "market_value_complete",
    "unrealised_before_fees_and_tax", "worker_id", "artifact_fingerprint"
  ],
  "properties": {
    "portfolio_snapshot_version": {"const": 3},
    "snapshot_id": {"type": "string", "pattern": "^psn_[a-z0-9_]{4,72}$"},
    "status": {"const": "completed"},
    "snapshot_status": {"enum": ["complete", "partial"]},
    "tenant_id": {"type": "string", "minLength": 1},
    "user_id": {"type": "string", "minLength": 1},
    "data_space_id": {"type": "string", "minLength": 1},
    "portfolio_id": {"type": "string", "minLength": 1},
    "portfolio_label": {"type": "string", "minLength": 1},
    "base_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "as_of_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "completed_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "freshness": {
      "type": "object",
      "required": ["overall_status", "levels"],
      "additionalProperties": true,
      "properties": {
        "overall_status": {"enum": ["not_requested", "source_gap", "stale_market", "stale_fifo", "valuation_pending", "complete"]},
        "levels": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["level_code", "status", "reason_code"],
            "properties": {
              "level_code": {"type": "string", "minLength": 3},
              "status": {"enum": ["not_requested", "source_gap", "stale_market", "stale_fifo", "valuation_pending", "complete"]},
              "reason_code": {"type": "string", "minLength": 3},
              "detail": {"type": "object"}
            }
          }
        }
      }
    },
    "positions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "quantity_decimal", "unit_value_decimal", "market_value_decimal"],
        "properties": {
          "asset_id": {"type": "string", "minLength": 3},
          "asset_name": {"type": ["string", "null"]},
          "asset_type": {"type": ["string", "null"]},
          "provider_symbol": {"type": ["string", "null"]},
          "native_currency": {"type": ["string", "null"]},
          "quantity_decimal": {"type": "string", "minLength": 1},
          "unit_value_decimal": {"type": "string", "minLength": 1},
          "market_value_decimal": {"type": "string", "minLength": 1},
          "cost_basis_decimal": {"type": ["string", "null"]},
          "unrealised_decimal": {"type": ["string", "null"]},
          "price_basis": {"type": ["string", "null"]},
          "price_source_date": {"type": ["string", "null"]},
          "substitution_used": {"type": "boolean"},
          "valuation_status": {"enum": ["complete", "substituted", "incomplete"]}
        }
      }
    },
    "excluded_positions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "reason", "owner_excluded"],
        "properties": {
          "asset_id": {"type": "string", "minLength": 3},
          "asset_name": {"type": ["string", "null"]},
          "reason": {"type": "string", "minLength": 3},
          "owner_excluded": {"type": "boolean"},
          "derived_value_decimal": {"type": ["string", "null"]},
          "cost_basis_decimal": {"type": ["string", "null"]},
          "unrealised_decimal": {"type": ["string", "null"]}
        }
      }
    },
    "totals": {
      "type": "object",
      "required": ["market_value_decimal", "cost_basis_decimal", "unrealised_decimal", "trade_derived_value_decimal"],
      "additionalProperties": false,
      "properties": {
        "market_value_decimal": {"type": ["string", "null"]},
        "cost_basis_decimal": {"type": ["string", "null"]},
        "unrealised_decimal": {"type": ["string", "null"]},
        "trade_derived_value_decimal": {"type": ["string", "null"]}
      }
    },
    "counts": {"type": "object"},
    "market_value_complete": {"type": "boolean"},
    "unrealised_before_fees_and_tax": {"const": true},
    "worker_id": {"type": "string", "minLength": 3},
    "artifact_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portelyra.local/contracts/desktop-statement-import-mapping/v1/mapping-profile.schema.json",
  "title": "Owner-local Statement mapping profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["statement_mapping_profile_version", "profile_ref", "context_fingerprint", "adapter_id", "adapter_version", "profile_label", "revision", "mapping_rows", "created_at_utc", "profile_fingerprint"],
  "properties": {
    "statement_mapping_profile_version": {"const": 1},
    "profile_ref": {"type": "string", "pattern": "^smp_[a-f0-9]{32}$"},
    "context_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "adapter_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{7,80}$"},
    "adapter_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "profile_label": {"type": "string", "minLength": 1, "maxLength": 100},
    "revision": {"type": "integer", "minimum": 1},
    "mapping_rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mappingRow"}},
    "created_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "profile_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "mappingRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_asset_key", "source_account_key", "event_type", "disposition", "target_asset_id", "target_account_id"],
      "properties": {
        "source_asset_key": {"type": "string", "minLength": 1, "maxLength": 200},
        "source_account_key": {"type": "string", "minLength": 1, "maxLength": 200},
        "event_type": {"type": "string", "minLength": 1, "maxLength": 200},
        "disposition": {"enum": ["map", "defer"]},
        "target_asset_id": {"type": ["string", "null"], "pattern": "^ast_[a-f0-9]{16,64}$"},
        "target_account_id": {"type": ["string", "null"], "pattern": "^acc_[a-f0-9]{16,64}$"}
      }
    }
  }
}

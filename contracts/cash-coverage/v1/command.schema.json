{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:portelyra:cash-coverage:v1:command",
  "oneOf": [
    {"$ref": "#/$defs/declare_top"},
    {"$ref": "#/$defs/cash_event_top"},
    {"$ref": "#/$defs/income_top"},
    {"$ref": "#/$defs/reconciliation_top"},
    {"$ref": "#/$defs/replacement_revision"},
    {"$ref": "#/$defs/void_revision"}
  ],
  "$defs": {
    "request": {"type": "string", "pattern": "^ccrq_[a-f0-9]{32}$"},
    "record_ref": {"type": "string", "pattern": "^cash_record_[a-f0-9]{32}$"},
    "id": {"type": "string", "pattern": "^(?:ptf|acc|ast)_[a-z0-9_]{4,60}$"},
    "date": {"type": "string", "format": "date"},
    "nullable_date": {"oneOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "local_time": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"},
    "time_zone": {"type": "string", "pattern": "^[A-Za-z0-9._+/-]{1,80}$"},
    "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "signed_decimal": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$", "not": {"const": "-0"}, "maxLength": 80},
    "positive_decimal": {"type": "string", "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9])$", "maxLength": 80},
    "metadata": {
      "type": "object",
      "required": ["request_ref", "input_mode", "source_candidate_fingerprint"],
      "properties": {
        "request_ref": {"$ref": "#/$defs/request"},
        "input_mode": {"enum": ["manual_entry", "reviewed_import"]},
        "source_candidate_fingerprint": {"oneOf": [{"$ref": "#/$defs/fingerprint"}, {"type": "null"}]}
      },
      "allOf": [
        {"if": {"properties": {"input_mode": {"const": "manual_entry"}}}, "then": {"properties": {"source_candidate_fingerprint": {"type": "null"}}}},
        {"if": {"properties": {"input_mode": {"const": "reviewed_import"}}}, "then": {"properties": {"source_candidate_fingerprint": {"$ref": "#/$defs/fingerprint"}}}}
      ]
    },
    "scope": {
      "type": "object",
      "required": ["portfolio_id", "account_id", "cash_asset_id"],
      "properties": {
        "portfolio_id": {"$ref": "#/$defs/id"}, "account_id": {"$ref": "#/$defs/id"}, "cash_asset_id": {"$ref": "#/$defs/id"}
      }
    },
    "declare_fields": {
      "type": "object",
      "required": ["action_type", "portfolio_id", "account_id", "cash_asset_id", "effective_from", "effective_to", "coverage_mode", "opening_balance_decimal", "opening_event_time_evidence", "opening_local_time", "opening_time_zone", "opening_effective_at_utc", "reconciliation_as_of_date", "observed_balance_decimal", "evidence_fingerprint"],
      "properties": {
        "action_type": {"const": "declare_coverage"},
        "portfolio_id": {"$ref": "#/$defs/id"}, "account_id": {"$ref": "#/$defs/id"}, "cash_asset_id": {"$ref": "#/$defs/id"},
        "effective_from": {"$ref": "#/$defs/date"}, "effective_to": {"$ref": "#/$defs/nullable_date"},
        "coverage_mode": {"enum": ["not_tracked", "income_only", "partial", "complete_reconciled"]},
        "opening_balance_decimal": {"oneOf": [{"$ref": "#/$defs/signed_decimal"}, {"type": "null"}]},
        "opening_event_time_evidence": {"enum": ["exact_local_zone", null]},
        "opening_local_time": {"oneOf": [{"$ref": "#/$defs/local_time"}, {"type": "null"}]},
        "opening_time_zone": {"oneOf": [{"$ref": "#/$defs/time_zone"}, {"type": "null"}]},
        "opening_effective_at_utc": {"oneOf": [{"$ref": "#/$defs/utc"}, {"type": "null"}]},
        "reconciliation_as_of_date": {"$ref": "#/$defs/nullable_date"},
        "observed_balance_decimal": {"oneOf": [{"$ref": "#/$defs/signed_decimal"}, {"type": "null"}]},
        "evidence_fingerprint": {"oneOf": [{"$ref": "#/$defs/fingerprint"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"coverage_mode": {"const": "complete_reconciled"}}},
          "then": {"properties": {
            "opening_balance_decimal": {"$ref": "#/$defs/signed_decimal"},
            "opening_event_time_evidence": {"const": "exact_local_zone"},
            "opening_local_time": {"$ref": "#/$defs/local_time"},
            "opening_time_zone": {"$ref": "#/$defs/time_zone"},
            "opening_effective_at_utc": {"$ref": "#/$defs/utc"},
            "reconciliation_as_of_date": {"$ref": "#/$defs/date"},
            "observed_balance_decimal": {"$ref": "#/$defs/signed_decimal"},
            "evidence_fingerprint": {"$ref": "#/$defs/fingerprint"}
          }},
          "else": {"properties": {
            "opening_balance_decimal": {"type": "null"}, "opening_event_time_evidence": {"type": "null"},
            "opening_local_time": {"type": "null"}, "opening_time_zone": {"type": "null"},
            "opening_effective_at_utc": {"type": "null"}, "reconciliation_as_of_date": {"type": "null"},
            "observed_balance_decimal": {"type": "null"}, "evidence_fingerprint": {"type": "null"}
          }}
        }
      ]
    },
    "cash_event_fields": {
      "type": "object",
      "required": ["action_type", "portfolio_id", "account_id", "cash_asset_id", "event_type", "related_account_id", "event_time_evidence", "local_date", "local_time", "time_zone", "effective_at_utc", "amount_decimal", "flow_classification"],
      "properties": {
        "action_type": {"const": "record_cash_event"},
        "portfolio_id": {"$ref": "#/$defs/id"}, "account_id": {"$ref": "#/$defs/id"}, "cash_asset_id": {"$ref": "#/$defs/id"},
        "event_type": {"enum": ["opening_balance", "deposit", "withdrawal", "transfer"]},
        "related_account_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "event_time_evidence": {"const": "exact_local_zone"}, "local_date": {"$ref": "#/$defs/date"},
        "local_time": {"$ref": "#/$defs/local_time"}, "time_zone": {"$ref": "#/$defs/time_zone"},
        "effective_at_utc": {"$ref": "#/$defs/utc"}, "amount_decimal": {"$ref": "#/$defs/signed_decimal"},
        "flow_classification": {"enum": ["not_applicable", "unclassified", "external_contribution", "external_withdrawal", "internal_unlinked", "investment_settlement", "income_receipt", "fee_or_tax_payment"]}
      }
    },
    "income_fields": {
      "type": "object",
      "required": ["action_type", "portfolio_id", "account_id", "cash_asset_id", "local_date", "gross_income_decimal", "linked_cash_event_ref"],
      "properties": {
        "action_type": {"const": "record_interest_income"},
        "portfolio_id": {"$ref": "#/$defs/id"}, "account_id": {"$ref": "#/$defs/id"}, "cash_asset_id": {"$ref": "#/$defs/id"},
        "local_date": {"$ref": "#/$defs/date"}, "gross_income_decimal": {"$ref": "#/$defs/positive_decimal"},
        "linked_cash_event_ref": {"oneOf": [{"type": "string", "pattern": "^cash_event_[0-9]{4}$"}, {"type": "null"}]}
      }
    },
    "reconciliation_fields": {
      "type": "object",
      "required": ["action_type", "portfolio_id", "account_id", "cash_asset_id", "as_of_date", "observed_balance_decimal", "evidence_fingerprint"],
      "properties": {
        "action_type": {"const": "record_reconciliation"},
        "portfolio_id": {"$ref": "#/$defs/id"}, "account_id": {"$ref": "#/$defs/id"}, "cash_asset_id": {"$ref": "#/$defs/id"},
        "as_of_date": {"$ref": "#/$defs/date"}, "observed_balance_decimal": {"$ref": "#/$defs/signed_decimal"},
        "evidence_fingerprint": {"$ref": "#/$defs/fingerprint"}
      }
    },
    "declare_top": {"allOf": [{"$ref": "#/$defs/metadata"}, {"$ref": "#/$defs/declare_fields"}], "unevaluatedProperties": false},
    "cash_event_top": {"allOf": [{"$ref": "#/$defs/metadata"}, {"$ref": "#/$defs/cash_event_fields"}], "unevaluatedProperties": false},
    "income_top": {"allOf": [{"$ref": "#/$defs/metadata"}, {"$ref": "#/$defs/income_fields"}], "unevaluatedProperties": false},
    "reconciliation_top": {"allOf": [{"$ref": "#/$defs/metadata"}, {"$ref": "#/$defs/reconciliation_fields"}], "unevaluatedProperties": false},
    "declare_nested": {"allOf": [{"$ref": "#/$defs/declare_fields"}], "unevaluatedProperties": false},
    "cash_event_nested": {"allOf": [{"$ref": "#/$defs/cash_event_fields"}], "unevaluatedProperties": false},
    "income_nested": {"allOf": [{"$ref": "#/$defs/income_fields"}], "unevaluatedProperties": false},
    "reconciliation_nested": {"allOf": [{"$ref": "#/$defs/reconciliation_fields"}], "unevaluatedProperties": false},
    "nested_regular": {"oneOf": [{"$ref": "#/$defs/declare_nested"}, {"$ref": "#/$defs/cash_event_nested"}, {"$ref": "#/$defs/income_nested"}, {"$ref": "#/$defs/reconciliation_nested"}]},
    "replacement_revision": {
      "allOf": [
        {"$ref": "#/$defs/metadata"},
        {"type": "object", "required": ["action_type", "predecessor_refs", "replacements"], "properties": {
          "action_type": {"enum": ["correct", "supersede"]},
          "predecessor_refs": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/record_ref"}},
          "replacements": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/nested_regular"}}
        }}
      ],
      "unevaluatedProperties": false
    },
    "void_revision": {
      "allOf": [
        {"$ref": "#/$defs/metadata"},
        {"type": "object", "required": ["action_type", "predecessor_refs", "replacements"], "properties": {
          "action_type": {"const": "void"},
          "predecessor_refs": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/record_ref"}},
          "replacements": {"type": "array", "maxItems": 0}
        }}
      ],
      "unevaluatedProperties": false
    }
  }
}

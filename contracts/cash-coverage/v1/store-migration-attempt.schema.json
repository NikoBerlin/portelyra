{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portelyra.local/contracts/cash-coverage/v1/store-migration-attempt.schema.json",
  "title": "Cash Coverage Store Migration Attempt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["cash_coverage_store_migration_attempt_version","confirmation_fingerprint","migration_plan_fingerprint","attempted_at_utc","attempt_status"],
  "properties": {
    "cash_coverage_store_migration_attempt_version": {"const": 1},
    "confirmation_fingerprint": {"$ref": "#/$defs/fingerprint"},
    "migration_plan_fingerprint": {"$ref": "#/$defs/fingerprint"},
    "attempted_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "attempt_status": {"const": "attempted"}
  },
  "$defs": {"fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}

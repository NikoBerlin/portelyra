{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portelyra.invalid/contracts/cash-coverage/v1/preview.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cash_coverage_version", "projection_status", "period_count", "periods", "cash_event_count", "income_event_count",
    "linked_income_event_count", "internal_transfer_count", "internal_transfer_portfolio_net_change_decimal",
    "income_cash_balance_effect_created", "cash_guv_from_balance_events_created", "external_counter_accounts_created",
    "full_double_entry_created", "coverage_inferred", "canonical_write", "provider_access", "network_access",
    "private_data_access", "preview_fingerprint"
  ],
  "properties": {
    "cash_coverage_version": {"const": 1},
    "projection_status": {"const": "coverage_preview_completed"},
    "period_count": {"type": "integer", "minimum": 1},
    "periods": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/period"}},
    "cash_event_count": {"type": "integer", "minimum": 0},
    "income_event_count": {"type": "integer", "minimum": 0},
    "linked_income_event_count": {"type": "integer", "minimum": 0},
    "internal_transfer_count": {"type": "integer", "minimum": 0},
    "internal_transfer_portfolio_net_change_decimal": {"const": "0"},
    "income_cash_balance_effect_created": {"const": false},
    "cash_guv_from_balance_events_created": {"const": false},
    "external_counter_accounts_created": {"const": false},
    "full_double_entry_created": {"const": false},
    "coverage_inferred": {"const": false},
    "canonical_write": {"const": false},
    "provider_access": {"const": false},
    "network_access": {"const": false},
    "private_data_access": {"const": false},
    "preview_fingerprint": {"$ref": "#/$defs/fingerprint"}
  },
  "$defs": {
    "ref": {"type": "string", "pattern": "^[a-z]{2,8}_[a-f0-9]{16,64}$"},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "date": {"type": "string", "format": "date"},
    "nullable_date": {"type": ["string", "null"], "format": "date"},
    "signed_decimal": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$"},
    "nullable_signed_decimal": {"oneOf": [{"$ref": "#/$defs/signed_decimal"}, {"type": "null"}]},
    "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "period": {
      "type": "object", "additionalProperties": false,
      "required": [
        "coverage_ref", "account_ref", "cash_asset_ref", "currency", "effective_from", "effective_to", "coverage_mode",
        "balance_status", "as_of_date", "opening_balance_decimal", "cash_movement_delta_decimal", "computed_balance_decimal",
        "observed_balance_decimal", "cash_event_count", "income_event_count", "gross_interest_income_decimal",
        "income_cash_balance_effect_created", "completeness_inferred", "period_fingerprint"
      ],
      "properties": {
        "coverage_ref": {"$ref": "#/$defs/ref"}, "account_ref": {"$ref": "#/$defs/ref"}, "cash_asset_ref": {"$ref": "#/$defs/ref"}, "currency": {"$ref": "#/$defs/currency"},
        "effective_from": {"$ref": "#/$defs/date"}, "effective_to": {"$ref": "#/$defs/nullable_date"},
        "coverage_mode": {"enum": ["not_tracked", "income_only", "partial", "complete_reconciled"]},
        "balance_status": {"enum": ["not_tracked", "partial_delta_only", "indicative_balance", "complete_reconciled"]},
        "as_of_date": {"$ref": "#/$defs/nullable_date"}, "opening_balance_decimal": {"$ref": "#/$defs/nullable_signed_decimal"},
        "cash_movement_delta_decimal": {"$ref": "#/$defs/signed_decimal"}, "computed_balance_decimal": {"$ref": "#/$defs/nullable_signed_decimal"},
        "observed_balance_decimal": {"$ref": "#/$defs/nullable_signed_decimal"}, "cash_event_count": {"type": "integer", "minimum": 0},
        "income_event_count": {"type": "integer", "minimum": 0}, "gross_interest_income_decimal": {"$ref": "#/$defs/signed_decimal"},
        "income_cash_balance_effect_created": {"const": false}, "completeness_inferred": {"const": false}, "period_fingerprint": {"$ref": "#/$defs/fingerprint"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portelyra.local/contracts/cash-coverage/v1/store-migration-receipt.schema.json",
  "title": "Cash Coverage Store Migration Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["singleton_id","migration_id","source_schema_version","target_schema_version","source_store_fingerprint","migration_plan_fingerprint","legacy_attempt_set_fingerprint","legacy_command_set_fingerprint","source_fact_projection_fingerprint","target_fact_projection_fingerprint","period_count","cash_event_count","income_event_count","reconciliation_count","migrated_at_utc","confirmation_fingerprint","recovery_confirmation_fingerprint","receipt_fingerprint"],
  "properties": {
    "singleton_id": {"const": 1},
    "migration_id": {"type": "string", "pattern": "^ccm_[a-f0-9]{32}$"},
    "source_schema_version": {"const": 2900},
    "target_schema_version": {"const": 2901},
    "source_store_fingerprint": {"$ref": "#/$defs/fingerprint"},
    "migration_plan_fingerprint": {"$ref": "#/$defs/fingerprint"},
    "legacy_attempt_set_fingerprint": {"$ref": "#/$defs/fingerprint"},
    "legacy_command_set_fingerprint": {"$ref": "#/$defs/fingerprint"},
    "source_fact_projection_fingerprint": {"$ref": "#/$defs/fingerprint"},
    "target_fact_projection_fingerprint": {"$ref": "#/$defs/fingerprint"},
    "period_count": {"type": "integer", "minimum": 0},
    "cash_event_count": {"type": "integer", "minimum": 0},
    "income_event_count": {"type": "integer", "minimum": 0},
    "reconciliation_count": {"type": "integer", "minimum": 0},
    "migrated_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "confirmation_fingerprint": {"$ref": "#/$defs/fingerprint"},
    "recovery_confirmation_fingerprint": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/fingerprint"}]},
    "receipt_fingerprint": {"$ref": "#/$defs/fingerprint"}
  },
  "$defs": {"fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}

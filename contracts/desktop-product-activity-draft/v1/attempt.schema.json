{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portelyra.local/contracts/desktop-product-activity-draft/v1/attempt.schema.json",
  "title": "Owner-only ActivityDraft attempt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["activity_draft_attempt_version", "attempt_status", "challenge_ref", "context_fingerprint", "draft_ref", "draft_revision", "validation_fingerprint", "confirmation_fingerprint", "confirmation", "committed_at_utc", "attempt_fingerprint"],
  "properties": {
    "activity_draft_attempt_version": {"const": 1},
    "attempt_status": {"const": "consumed_before_domain_write"},
    "challenge_ref": {"type": "string", "pattern": "^adc_[a-f0-9]{16,64}$"},
    "context_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "draft_ref": {"type": "string", "pattern": "^adt_[a-f0-9]{32}$"},
    "draft_revision": {"type": "integer", "minimum": 1},
    "validation_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "confirmation_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "confirmation": {"$ref": "confirmation.schema.json"},
    "committed_at_utc": {"type": "string", "format": "date-time"},
    "attempt_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}

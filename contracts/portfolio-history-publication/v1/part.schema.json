   }
  },
  "amount": {
   "type": [
    "string",
    "null"
   ],
   "pattern": "^-?[0-9]+(\\.[0-9]+)?(/[1-9][0-9]*)?$"
  },
  "amounts": {
   "type": "array",
   "maxItems": 40000,
   "items": {
    "type": [
     "string",
     "null"
    ],
    "pattern": "^-?[0-9]+(\\.[0-9]+)?(/[1-9][0-9]*)?$"
   }
  },

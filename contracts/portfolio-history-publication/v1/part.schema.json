{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "portfolio_history_part_v1",
 "title": "Teildatei der Tageshistorie (#503): die Tagesreihen eines Assets, einer Klasse, einer eigenen Gruppe oder eines beobachteten Assets",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "portfolio_history_part_version",
  "tenant_id",
  "user_id",
  "data_space_id",
  "kind",
  "fields"
 ],
 "properties": {
  "portfolio_history_part_version": {
   "const": 1
  },
  "tenant_id": {
   "type": "string",
   "minLength": 3,
   "maxLength": 80
  },
  "user_id": {
   "type": "string",
   "minLength": 3,
   "maxLength": 80
  },
  "data_space_id": {
   "type": "string",
   "minLength": 8,
   "maxLength": 64
  },
  "kind": {
   "enum": [
    "asset",
    "class",
    "group",
    "watched"
   ]
  },
  "fields": {
   "type": "object"
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "kind": {
      "const": "asset"
     }
    }
   },
   "then": {
    "properties": {
     "fields": {
      "$ref": "#/$defs/asset_fields"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "class"
     }
    }
   },
   "then": {
    "properties": {
     "fields": {
      "$ref": "#/$defs/class_fields"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "group"
     }
    }
   },
   "then": {
    "properties": {
     "fields": {
      "$ref": "#/$defs/group_fields"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "watched"
     }
    }
   },
   "then": {
    "properties": {
     "fields": {
      "$ref": "#/$defs/watched_fields"
     }
    }
   }
  }
 ],
 "$defs": {
  "day": {

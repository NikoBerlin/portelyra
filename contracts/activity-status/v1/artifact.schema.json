{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "activity_status_v1",
 "title": "Veroeffentlichter Stand der Aktualisierung (#540)",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "activity_status_version",
  "activity_status_id",
  "status",
  "tenant_id",
  "user_id",
  "data_space_id",
  "running",
  "last",
  "next",
  "provider_access",
  "network_access",
  "canonical_write",
  "content_fingerprint",
  "completed_at_utc",
  "artifact_fingerprint"
 ],
 "properties": {
  "activity_status_version": {
   "const": 1
  },
  "activity_status_id": {
   "type": "string",
   "pattern": "^act_[a-f0-9]{32}$"
  },
  "status": {
   "const": "completed"
  },
  "tenant_id": {
   "type": "string",
   "minLength": 3,
   "maxLength": 80
  },
  "user_id": {
   "type": "string",
   "minLength": 3,
   "maxLength": 80
  },
  "data_space_id": {
   "type": "string",
   "minLength": 8,
   "maxLength": 64
  },
  "running": {
   "type": "array",
   "maxItems": 5,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "kind",
     "origin",
     "started_at_utc",
     "step_label",
     "step_position",
     "step_count",
     "done",
     "total",
     "expected_end_utc"
    ],
    "properties": {
     "kind": {
      "enum": [
       "refresh",
       "moment",
       "sweep",
       "names",
       "maintenance",
       "other"
      ]
     },
     "origin": {
      "enum": [
       "app",
       "timer",
       "other"
      ]
     },
     "started_at_utc": {
      "type": [
       "string",
       "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
     },
     "step_label": {
      "type": [
       "string",
       "null"
      ],
      "minLength": 1,
      "maxLength": 80
     },
     "step_position": {
      "type": [
       "integer",
       "null"
      ],
      "minimum": 0,
      "maximum": 10000000
     },
     "step_count": {
      "type": [
       "integer",
       "null"
      ],
      "minimum": 0,
      "maximum": 10000000
     },
     "done": {
      "type": [
       "integer",
       "null"
      ],
      "minimum": 0,
      "maximum": 10000000
     },
     "total": {
      "type": [
       "integer",
       "null"
      ],
      "minimum": 0,
      "maximum": 10000000
     },
     "expected_end_utc": {
      "type": [
       "string",
       "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
     }
    }
   }
  },
  "last": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "refresh",
    "moment"
   ],
   "properties": {
    "refresh": {
     "type": [
      "object",
      "null"
     ],
     "additionalProperties": false,
     "required": [
      "finished_at_utc",
      "title",
      "tone",
      "seconds"
     ],
     "properties": {
      "finished_at_utc": {
       "type": "string",
       "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
      },
      "title": {
       "type": "string",
       "minLength": 1,
       "maxLength": 120
      },
      "tone": {
       "enum": [
        "positive",
        "neutral",
        "warning",
        "error"
       ]
      },
      "seconds": {
       "type": [
        "integer",
        "null"
       ],
       "minimum": 0,
       "maximum": 10000000
      }
     }
    },
    "moment": {
     "type": [
      "object",
      "null"
     ],
     "additionalProperties": false,
     "required": [
      "finished_at_utc",
      "title",
      "tone",
      "seconds"
     ],
     "properties": {
      "finished_at_utc": {
       "type": "string",
       "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
      },
      "title": {
       "type": "string",
       "minLength": 1,
       "maxLength": 120
      },
      "tone": {
       "enum": [
        "positive",
        "neutral",
        "warning",
        "error"
       ]
      },
      "seconds": {
       "type": [
        "integer",
        "null"
       ],
       "minimum": 0,
       "maximum": 10000000
      }
     }
    }
   }
  },
  "next": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "refresh",
    "moment"
   ],
   "properties": {
    "refresh": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "enabled",
      "times"
     ],
     "properties": {
      "enabled": {
       "type": "boolean"
      },
      "times": {
       "type": "array",
       "maxItems": 6,
       "items": {
        "type": "string",
        "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
       },
       "uniqueItems": true
      }
     }
    },
    "moment": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "enabled",
      "times"
     ],
     "properties": {
      "enabled": {
       "type": "boolean"
      },
      "times": {
       "type": "array",
       "maxItems": 6,
       "items": {
        "type": "string",
        "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
       },
       "uniqueItems": true
      }
     }
    }
   }
  },
  "provider_access": {
   "const": false
  },
  "network_access": {
   "const": false
  },
  "canonical_write": {
   "const": false
  },
  "content_fingerprint": {
   "type": "string",
   "pattern": "^[a-f0-9]{64}$"
  },
  "completed_at_utc": {
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
  },
  "artifact_fingerprint": {
   "type": "string",
   "pattern": "^[a-f0-9]{64}$"
  }
 }
}

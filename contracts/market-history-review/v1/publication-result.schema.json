{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portelyra.invalid/contracts/market-history-review/v1/publication-result.schema.json",
  "title": "Desktop staged Market History publication result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "market_history_review_publication_result_version", "status", "review_ref", "mode",
    "scope_start_date", "scope_end_date", "appended_day_count", "corrected_day_count",
    "unchanged_day_count", "observed_candidate_count", "non_trading_day_count",
    "source_gap_count", "imputed_non_trading_day_count", "warning_count", "exact_replay",
    "provider_access", "network_access", "provider_refetch", "market_history_write",
    "canonical_write", "tax_write", "reward_valuation_write", "automatic_retry",
    "candidate_fingerprint_exposed", "receipt_fingerprint_exposed", "context_exposed",
    "paths_exposed", "internal_id_exposed"
  ],
  "properties": {
    "market_history_review_publication_result_version": {"const": 1},
    "status": {"const": "published"},
    "review_ref": {"type": "string", "pattern": "^mhr_[a-f0-9]{32}$"},
    "mode": {"enum": ["incremental", "retry_source_gaps", "full_refresh"]},
    "scope_start_date": {"type": "string", "format": "date"},
    "scope_end_date": {"type": "string", "format": "date"},
    "appended_day_count": {"type": "integer", "minimum": 0, "maximum": 3650},
    "corrected_day_count": {"type": "integer", "minimum": 0, "maximum": 3650},
    "unchanged_day_count": {"type": "integer", "minimum": 0, "maximum": 3650},
    "observed_candidate_count": {"type": "integer", "minimum": 0, "maximum": 3650},
    "non_trading_day_count": {"type": "integer", "minimum": 0, "maximum": 3650},
    "source_gap_count": {"type": "integer", "minimum": 0, "maximum": 3650},
    "imputed_non_trading_day_count": {"type": "integer", "minimum": 0, "maximum": 3650},
    "warning_count": {"type": "integer", "minimum": 0, "maximum": 8},
    "exact_replay": {"type": "boolean"},
    "provider_access": {"const": false},
    "network_access": {"const": false},
    "provider_refetch": {"const": false},
    "market_history_write": {"const": true},
    "canonical_write": {"const": false},
    "tax_write": {"const": false},
    "reward_valuation_write": {"const": false},
    "automatic_retry": {"const": false},
    "candidate_fingerprint_exposed": {"const": false},
    "receipt_fingerprint_exposed": {"const": false},
    "context_exposed": {"const": false},
    "paths_exposed": {"const": false},
    "internal_id_exposed": {"const": false}
  }
}

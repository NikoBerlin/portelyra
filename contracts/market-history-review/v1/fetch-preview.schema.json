{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portelyra.invalid/contracts/market-history-review/v1/fetch-preview.schema.json",
  "title": "Desktop staged Market History fetch preview v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "market_history_review_fetch_preview_version", "status", "listing_browser_ref",
    "quote_currency", "market_code", "calendar_kind", "mode", "scope_start_date",
    "scope_end_date", "target_day_count", "provider_call_count",
    "fetch_confirmation_required", "provider_access", "network_access",
    "staging_write_after_confirmation", "market_history_write",
    "publish_confirmation_required_later", "provider_refetch_on_publish",
    "canonical_write", "automatic_retry", "candidate_fingerprint_exposed",
    "context_exposed", "paths_exposed", "internal_id_exposed"
  ],
  "properties": {
    "market_history_review_fetch_preview_version": {"const": 1},
    "status": {"const": "pending_fetch_confirmation"},
    "listing_browser_ref": {"type": "string", "pattern": "^market_listing_[a-f0-9]{32}$"},
    "quote_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "market_code": {"type": "string", "pattern": "^[A-Z0-9]{2,12}$"},
    "calendar_kind": {"enum": ["exchange_calendar", "continuous_24_7"]},
    "mode": {"enum": ["incremental", "retry_source_gaps", "full_refresh"]},
    "scope_start_date": {"type": "string", "format": "date"},
    "scope_end_date": {"type": "string", "format": "date"},
    "target_day_count": {"type": "integer", "minimum": 1, "maximum": 3650},
    "provider_call_count": {"const": 1},
    "fetch_confirmation_required": {"const": true},
    "provider_access": {"const": false},
    "network_access": {"const": false},
    "staging_write_after_confirmation": {"const": true},
    "market_history_write": {"const": false},
    "publish_confirmation_required_later": {"const": true},
    "provider_refetch_on_publish": {"const": false},
    "canonical_write": {"const": false},
    "automatic_retry": {"const": false},
    "candidate_fingerprint_exposed": {"const": false},
    "context_exposed": {"const": false},
    "paths_exposed": {"const": false},
    "internal_id_exposed": {"const": false}
  }
}

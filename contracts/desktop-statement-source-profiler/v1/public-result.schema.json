{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portelyra.invalid/contracts/desktop-statement-source-profiler/v1/public-result.schema.json",
  "title": "Desktop Statement Source Profiler Public Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "activation_authorized", "ambiguous_role_count", "automatic_retry", "canonical_write", "cash_write",
    "column_count", "decimal_format_review_required", "delimiter", "duplicate_header_count",
    "duplicate_source_row_id_count", "encoding", "header_values_exposed", "missing_role_count",
    "missing_source_row_id_count", "network_access", "private_values_published", "provider_access",
    "route_rules_created", "row_count", "semantic_tuple_count", "semantic_values_exposed", "silent_drop_count",
    "source_path_exposed", "statement_source_profiler_public_result_version", "status", "time_format", "time_zone_inferred",
    "unmapped_column_count"
  ],
  "properties": {
    "activation_authorized": {"const": false},
    "ambiguous_role_count": {"type": "integer", "minimum": 0},
    "automatic_retry": {"const": false},
    "canonical_write": {"const": false},
    "cash_write": {"const": false},
    "column_count": {"type": "integer", "minimum": 2},
    "decimal_format_review_required": {"type": "boolean"},
    "delimiter": {"enum": ["comma", "semicolon", "tab"]},
    "duplicate_header_count": {"type": "integer", "minimum": 0},
    "duplicate_source_row_id_count": {"type": "integer", "minimum": 0},
    "encoding": {"enum": ["utf8", "utf8_bom"]},
    "header_values_exposed": {"const": false},
    "missing_role_count": {"type": "integer", "minimum": 0},
    "missing_source_row_id_count": {"type": "integer", "minimum": 0},
    "network_access": {"const": false},
    "private_values_published": {"const": false},
    "provider_access": {"const": false},
    "route_rules_created": {"const": false},
    "row_count": {"type": "integer", "minimum": 1},
    "semantic_tuple_count": {"type": "integer", "minimum": 0},
    "semantic_values_exposed": {"const": false},
    "silent_drop_count": {"const": 0},
    "source_path_exposed": {"const": false},
    "statement_source_profiler_public_result_version": {"const": 1},
    "status": {"enum": ["ready_for_owner_semantic_review", "owner_mapping_or_format_review_required"]},
    "time_format": {"enum": ["ymd_space_hms", "ymd_space_hms_fraction", "iso_utc", "iso_offset", "no_nonempty_values", "mixed_or_unknown", "unavailable"]},
    "time_zone_inferred": {"const": false},
    "unmapped_column_count": {"type": "integer", "minimum": 0}
  }
}

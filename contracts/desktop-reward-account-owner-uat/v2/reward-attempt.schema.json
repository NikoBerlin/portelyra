{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "activation_authorized",
    "attempt_fingerprint",
    "automatic_retry_authorized",
    "context_binding_sha256",
    "created_at_utc",
    "private_values_published",
    "profiler_authorization_sha256",
    "selection_binding_sha256",
    "source_path_retained",
    "status",
    "version"
  ],
  "properties": {
    "activation_authorized": {
      "const": false
    },
    "attempt_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "automatic_retry_authorized": {
      "const": false
    },
    "context_binding_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_at_utc": {
      "type": "string"
    },
    "private_values_published": {
      "const": false
    },
    "profiler_authorization_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "selection_binding_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_path_retained": {
      "const": false
    },
    "status": {
      "const": "reward_authorization_consumed_before_source_read"
    },
    "version": {
      "const": 2
    }
  }
}
